# Oficina y servicio en lenguaje humano (recomendado). Ejemplos:
#   OFICINA=Registro Civil de Granada
#   SERVICIO=Juras de nacionalidad
# El bot resuelve estos nombres a los IDs reales consultando el portal.
OFICINA=
SERVICIO=

# ID del servicio (atajo de desarrollador). Solo se usa si OFICINA y SERVICIO
# están vacíos. Para conocerlo: deja OFICINA/SERVICIO, ejecuta y lee el log.
ID_SERVICIO=

# Cliente y número de solicitantes del portal de la Junta de Andalucía
ID_CLIENTE=4
NUM_SOLICITANTES=1

# Intervalo entre recordatorios (minutos) y tiempo de vida de la notificación (horas)
REMINDER_INTERVAL_MINUTES=60*12
NOTIFICATION_TTL_HOURS=25

# Rango de fechas a vigilar (inclusive), formato YYYY-MM-DD
FECHA_DESDE=2026-09-16
FECHA_HASTA=2026-09-18

# Intervalo entre consultas (milisegundos). Se elige un valor aleatorio entre ambos.
POLL_MIN_MS=45000
POLL_MAX_MS=90000

# Notificación iPhone vía ntfy (opcional). Ejemplo: https://ntfy.sh/mi-topico-privado
NTFY_TOPIC_URL=

# WhatsApp vía Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+5215555555555
