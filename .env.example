# Servicio y cliente del portal de la Junta de Andalucía
ID_SERVICIO=180
ID_CLIENTE=4
NUM_SOLICITANTES=1

# Intervalo entre recordatorios (minutos) y tiempo de vida de la notificación (horas)
REMINDER_INTERVAL_MINUTES=60*12
NOTIFICATION_TTL_HOURS=25

# Rango de fechas a vigilar (inclusive), formato YYYY-MM-DD
FECHA_DESDE=2026-09-16
FECHA_HASTA=2026-09-18

# Intervalo entre consultas (milisegundos). Se elige un valor aleatorio entre ambos.
POLL_MIN_MS=45000
POLL_MAX_MS=90000

# Notificación iPhone vía ntfy (opcional). Ejemplo: https://ntfy.sh/mi-topico-privado
NTFY_TOPIC_URL=

# WhatsApp vía Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+5215555555555

# Voz (recordatorio de que hay hueco) vía Twilio (opcional)
TWILIO_VOICE_FROM=
VOICE_TO=+5215555555555
